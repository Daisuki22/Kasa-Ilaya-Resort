{
  "name": "Booking",
  "type": "object",
  "properties": {
    "booking_reference": {
      "type": "string",
      "description": "Unique booking reference code"
    },
    "package_id": {
      "type": "string",
      "description": "Reference to the package"
    },
    "package_name": {
      "type": "string",
      "description": "Name of the booked package"
    },
    "tour_type": {
      "type": "string",
      "enum": [
        "day_tour",
        "night_tour",
        "22_hours"
      ],
      "description": "Selected tour type"
    },
    "booking_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the reservation"
    },
    "guest_count": {
      "type": "number",
      "description": "Number of guests"
    },
    "customer_name": {
      "type": "string",
      "description": "Full name of the customer"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "special_requests": {
      "type": "string",
      "description": "Any special requests"
    },
    "total_amount": {
      "type": "number",
      "description": "Total booking amount"
    },
    "reservation_fee_amount": {
      "type": "number",
      "default": 0,
      "description": "Calculated 15% reservation fee"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "downpayment",
        "full_payment"
      ],
      "default": "downpayment",
      "description": "Chosen payment type for the booking"
    },
    "payment_amount_due": {
      "type": "number",
      "default": 0,
      "description": "Amount the guest chose to pay during booking submission"
    },
    "payment_mode": {
      "type": "string",
      "description": "Selected mode or channel of payment"
    },
    "payment_qr_code_id": {
      "type": "string",
      "description": "Selected payment QR code record ID"
    },
    "payment_qr_code_label": {
      "type": "string",
      "description": "Selected payment QR code label"
    },
    "additional_fee_amount": {
      "type": "number",
      "default": 0,
      "description": "Additional fee for damaged or broken resort property"
    },
    "additional_fee_reason": {
      "type": "string",
      "description": "Note describing the damaged or broken property fee"
    },
    "additional_fee_status": {
      "type": "string",
      "enum": [
        "pending",
        "unpaid",
        "paid"
      ],
      "default": "unpaid",
      "description": "Payment status for the additional broken-property fee"
    },
    "rebooking_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "declined"
      ],
      "default": "none",
      "description": "Current rebooking request status"
    },
    "rebooking_original_date": {
      "type": "string",
      "format": "date",
      "description": "Original booking date before rebooking"
    },
    "rebooking_requested_date": {
      "type": "string",
      "format": "date",
      "description": "New date requested by the guest"
    },
    "rebooking_reason": {
      "type": "string",
      "description": "Guest reason for requesting rebooking"
    },
    "rebooking_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the guest requested rebooking"
    },
    "rebooking_resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the rebooking request was approved or declined"
    },
    "rebooking_resolution_note": {
      "type": "string",
      "description": "Admin note for the rebooking decision"
    },
    "rebooking_count": {
      "type": "number",
      "default": 0,
      "description": "Number of approved rebookings for this reservation"
    },
    "receipt_url": {
      "type": "string",
      "description": "Uploaded receipt image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending",
      "description": "Booking status"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "pending_verification",
        "paid"
      ],
      "default": "unpaid",
      "description": "Payment status"
    }
  },
  "required": [
    "package_id",
    "booking_date",
    "customer_name",
    "customer_email",
    "customer_phone"
  ]
}
